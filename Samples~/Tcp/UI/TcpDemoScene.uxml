<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="TcpDemoScene.uss" />
  <ui:VisualElement name="root" class="root">
    <ui:Label text="TCP 会话列表" class="title" />

    <ui:VisualElement class="toolbar">
      <ui:Button name="create-button" text="创建链接" class="action-button primary" />
    </ui:VisualElement>

    <ui:ScrollView name="connection-list" class="connection-list" />

    <ui:Label name="status-label" text="未启动" class="status" />
  </ui:VisualElement>
</ui:UXML>